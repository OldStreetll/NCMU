# .env.bootstrap.example — TASK-42 / B-NEW-14 token auto-sync bootstrap
#
# Copy this file to `.env.bootstrap` and fill in actual credentials.
# `.env.bootstrap` is gitignored — never commit real credentials.
#
# Used by `scripts/ncmu_init.py` token-sync flow:
#   1. Detects CHANGE_ME placeholders in `.env` for known token keys.
#   2. Reads admin credentials from this file.
#   3. Logs into Dify Console (POST /console/api/login w/ base64 password).
#   4. Fetches DIFY_CONSOLE_API_KEY (access_token JWT) + DIFY_APP_DEFAULT_TOKEN
#      (per-App api-key via /console/api/apps/{app_id}/api-keys).
#   5. Atomically writes resolved tokens back to `.env`.
#   6. Prints `Please restart ncmu-backend: docker compose restart ncmu-backend`
#      and exits cleanly (no further init steps in same run).
#
# FastGPT auto-sync (FASTGPT_API_KEY / FASTGPT_ROOT_KEY / FASTGPT_TOKEN_KEY /
# FASTGPT_FILE_TOKEN_KEY): pending TASK-42 主体 spike of v4.14.x team_api_keys
# endpoint. Until implemented, ncmu-init emits STDERR warn for these keys
# without writing to .env. Operator must seed them manually in `.env`.
#
# SILICONFLOW_API_KEY: cannot be auto-synced. Obtain at https://siliconflow.cn
# and set the value below; ncmu-init will copy from .env.bootstrap to .env
# in a future Phase (currently only emits STDERR guidance).

# === Dify admin credentials (used to login + retrieve console/app tokens) ===
# Plain-text password; ncmu-init base64-encodes internally for the login POST.
DIFY_ADMIN_EMAIL=admin@ncmu.local
DIFY_ADMIN_PASSWORD=YOUR_DIFY_ADMIN_PASSWORD_HERE

# === FastGPT root credentials (for future FASTGPT_* auto-sync) ===
# Pending FastGPT v4.14.x team_api_keys endpoint spike (TASK-42 主体 H1).
# Currently unused by ncmu-init; operator should still seed real FASTGPT_*
# values directly in `.env` (deployment-time secrets).
FASTGPT_ADMIN_EMAIL=root
FASTGPT_ADMIN_PASSWORD=YOUR_FASTGPT_ROOT_PASSWORD_HERE

# === SiliconFlow embedding API key (errata-11 衔接) ===
# Obtain at https://siliconflow.cn after registering. Required when
# FastGPT embedding switches to bge-large-zh-v1.5 via SiliconFlow's
# free API instead of the local TEI fallback. Currently ncmu-init only
# detects the placeholder and prints guidance; manual seed to `.env`
# remains the operator's responsibility until a future sync flow lands.
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
