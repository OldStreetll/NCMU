.env
.env.local
.env.*.local
# TASK-42 token-sync bootstrap; contains plain-text admin credentials.
# Never tracked. Companion `.env.bootstrap.example` is committed as a
# template (no real secrets).
.env.bootstrap
# Ad-hoc .env backup snapshots taken during destructive ops (eg.
# TASK-79b token-sync regression). REWORK-81-NIT INDEP-4: previous
# practice of leaving `.env.bak-YYYY-MM-DD-...` files untracked
# tempted `git add -A` accidents; cover the pattern explicitly so a
# future bulk-add cannot pick them up.
.env.bak-*
*.pyc
__pycache__/
.venv/
venv/
node_modules/
.DS_Store

# Postgres / Redis bind-mount data dirs (TASK-05 base compose).
# Treat as ephemeral; never tracked. Override with named volumes
# on Windows/WSL2 via docker-compose.override.yaml.
/data/

# Local docker-compose override (cp from .example for NTFS hosts).
# Per Pane 5 REVIEW-04 COMMENT 2: keep override out of git so each
# host can choose its own volume strategy.
docker-compose.override.yaml
