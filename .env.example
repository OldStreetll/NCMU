# =====================================================================
# NCMU v3.3.1 Environment Template
# =====================================================================
# Usage:
#   cp .env.example .env
#   then replace every CHANGE_ME placeholder with a real value.
#
# DO NOT commit .env. Only .env.example is tracked.
# Image tag values come from the version lock file; do not change them
# in isolation — coordinate with Pane 0 + the lock file first.
#
# References:
#   Version locking : NCMU-Wiki/sources/phase0/versions-locked-2026-04-21.md
#   Prerequisites   : NCMU-Wiki/sources/phase0/prerequisites-2026-04-21.md
#   Full spec       : NCMU-Wiki/sources/specs/ncmu-dify-design-v3.md
#                     Appendix A, lines 1821-1892
#
# Host environment notes (per prerequisites §2 + §3):
#   - On Windows / WSL2 with NCMU/ on /mnt/d (NTFS), copy
#     docker-compose.override.yaml.example -> docker-compose.override.yaml
#     so the three postgres services use named volumes (bind mount on
#     NTFS will fail with "could not change permissions" at initdb).
#   - Clash TUN users: add DIRECT rules for dify.ai / docker.io /
#     docker.com / aliyuncs.com / ghcr.io before running docker pull.
# =====================================================================


# ========== DEPLOY PROFILE ==========
# DEPLOY_PROFILE switches dev/prod profile in docker-compose.
# FRONTEND_URL is consumed by ncmu-backend for CORS allow-list.
DEPLOY_PROFILE=dev
FRONTEND_URL=http://localhost


# ========== COOKIE POLICY ==========
# v3.3 unifies dev/prod on SameSite=Strict so dev exercises the same
# CSRF code path as prod. COOKIE_SECURE must be true on prod (HTTPS).
COOKIE_SAMESITE=Strict
COOKIE_SECURE=false


# ========== FRONTEND BUILD ==========
# Baked into the React SPA at build time (Vite).
# dev: same-origin /api ; prod: e.g. https://api.ncmu.example.com
VITE_API_BASE_URL=/api


# ========== POSTGRES (pg-ncmu) ==========
# pg-ncmu hosts the three v3.3 Dify-integration tables (dify_apps,
# dify_external_kb_configs, dify_app_kb_bindings) plus all Phase 1
# ncmu-backend tables. Consumed only by ncmu-backend.
NCMU_DB_HOST=pg-ncmu
NCMU_DB_PORT=5432
NCMU_DB_USER=ncmu_app
NCMU_DB_NAME=ncmu
NCMU_APP_PASSWORD=CHANGE_ME
NCMU_DB_URL=postgresql://ncmu_app:CHANGE_ME@pg-ncmu:5432/ncmu


# ========== POSTGRES (pg-dify) ==========
# pg-dify hosts Dify's metadata DB (apps, conversations, datasets).
# Host-side port 5433 to avoid colliding with pg-ncmu (5432).
# POSTGRES_* vars feed the postgres:16-alpine image's env for pg-dify.
DIFY_DB_HOST=pg-dify
DIFY_DB_PORT=5432
DIFY_DB_HOST_PORT=5433
DIFY_DB_USER=dify
DIFY_DB_PASSWORD=CHANGE_ME
DIFY_DB_NAME=dify
DIFY_DB_URL=postgresql://dify:CHANGE_ME@pg-dify:5432/dify


# ========== POSTGRES (pg-fastgpt) ==========
# pg-fastgpt hosts FastGPT's metadata + pgvector embeddings.
# Image tag deferred to TASK-07 (FastGPT-recommended pgvector image).
# Host-side port 5434.
FASTGPT_DB_HOST=pg-fastgpt
FASTGPT_DB_PORT=5432
FASTGPT_DB_HOST_PORT=5434
FASTGPT_DB_USER=fastgpt
FASTGPT_DB_PASSWORD=CHANGE_ME
FASTGPT_DB_NAME=fastgpt
FASTGPT_DB_URL=postgresql://fastgpt:CHANGE_ME@pg-fastgpt:5432/fastgpt


# ========== REDIS ==========
# Single redis instance with AOF persistence; logical DBs:
#   /0 ncmu-backend, /1 Dify, /2 FastGPT (TASK-05/06/07 enforce).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0


# ========== DIFY ==========
# DIFY_BASE_URL is the in-cluster URL ncmu-backend uses to call Dify.
# DIFY_API_KEY is per-app, encrypted at rest in dify_apps; this default
# value is only used by sync scripts. DIFY_CONSOLE_API_KEY is the admin
# console token used for app/dataset sync (rotates manually).
# DIFY_PORT is the host port mapped to the internal dify-nginx proxy.
DIFY_BASE_URL=http://dify-api:5001
DIFY_API_KEY=CHANGE_ME
DIFY_CONSOLE_API_KEY=CHANGE_ME
DIFY_PORT=8080

# Dify application-internal secrets. Rotate via `.env` file only; all
# three drive Dify's own crypto (session tokens / inter-service auth /
# plugin daemon handshake). Regenerate each with `openssl rand -base64 42`.
DIFY_SECRET_KEY=CHANGE_ME
DIFY_SANDBOX_API_KEY=CHANGE_ME
DIFY_PLUGIN_DAEMON_KEY=CHANGE_ME
DIFY_PLUGIN_INNER_API_KEY=CHANGE_ME

# INIT_PASSWORD, if set, seeds the Dify admin account on first boot. Leave
# blank to drive the manual install wizard at http://localhost:${DIFY_PORT}
# /install after `docker compose up`.
DIFY_INIT_PASSWORD=

# Dify plugin daemon uses its own DB on the same pg-dify instance. The
# `dify-init-plugin-db` compose service creates it idempotently; change
# the name here if you rename it.
DIFY_DB_PLUGIN_DATABASE=dify_plugin

# Dify -> NCMU redis. NCMU reserves DB 0 for ncmu-backend, 1 for Dify,
# 2 for FastGPT. Keep DIFY_REDIS_DB=1 in sync with ncmu-backend's reserve.
DIFY_REDIS_DB=1
DIFY_CELERY_BROKER_URL=redis://redis:6379/1

# Dify vector store (per NCMU-Wiki/.../versions-locked-2026-04-21-errata-02.md):
# NCMU replaces Dify upstream's default Weaviate container with pgvector
# on the existing pg-dify instance — save ~1.5-2 GiB WSL2 memory and
# keep the vector technology stack uniform with pg-fastgpt.
# PGVECTOR_PASSWORD defaults to DIFY_DB_PASSWORD so pg-dify auth works
# with a single credential; override here only if you want a dedicated
# Dify-vector user (not recommended for Phase 0).
DIFY_VECTOR_STORE=pgvector
PGVECTOR_HOST=pg-dify
PGVECTOR_PORT=5432
PGVECTOR_USER=dify
PGVECTOR_PASSWORD=CHANGE_ME
PGVECTOR_DATABASE=dify


# ========== FASTGPT ==========
# FASTGPT_BASE_URL is the in-cluster URL kb-adapter calls.
# FASTGPT_API_KEY is generated in FastGPT admin and is INDEPENDENT of
# the keys placed in KB_ADAPTER_ALLOWED_KEYS (those are Dify -> kb-adapter).
# FASTGPT_LLM_* targets the external MiniMax endpoint (per prerequisites §6).
# FASTGPT_EMBEDDING_* targets the in-cluster TEI worker.
# STORAGE_EXTERNAL_ENDPOINT lets FastGPT reach a host-running MinIO; on
# Windows/macOS use host.docker.internal:9000 (per prerequisites §4),
# on Linux prod replace with the LAN MinIO IP.
FASTGPT_BASE_URL=http://fastgpt:3000
FASTGPT_API_KEY=CHANGE_ME
FASTGPT_PORT=3000
FASTGPT_EMBEDDING_MODEL=bge-large-zh-v1.5
FASTGPT_EMBEDDING_BASE_URL=http://tei:80
FASTGPT_LLM_BASE_URL=http://111.172.214.40:32086/v1
FASTGPT_LLM_API_KEY=CHANGE_ME
FASTGPT_LLM_MODEL=MiniMax-M2.7
STORAGE_EXTERNAL_ENDPOINT=http://host.docker.internal:9000


# ========== KB-ADAPTER ==========
# Comma-separated bearer tokens accepted by kb-adapter /retrieval.
# Each value MUST also exist in dify_external_kb_configs.api_key_encrypted
# (Fernet-decrypted to plaintext). Rotate by replacing the env value and
# bouncing the container — old keys stop working immediately.
KB_ADAPTER_ALLOWED_KEYS=CHANGE_ME
KB_ADAPTER_BASE_URL=http://kb-adapter:8000
KB_ADAPTER_PORT=8000


# ========== NCMU-BACKEND ==========
# JWT_SECRET signs both access + refresh tokens.
# HMAC_SECRET signs DingTalk callback / Stream Bot payloads (per §13).
# FERNET_KEY encrypts dify_external_kb_configs.api_key_encrypted; spec
# §Appendix A says "derived from JWT_SECRET" but in v3.3.1 it is an
# independent secret (rotate JWT without re-encrypting all KB keys).
JWT_SECRET=CHANGE_ME
HMAC_SECRET=CHANGE_ME
FERNET_KEY=CHANGE_ME
NCMU_BACKEND_PORT=8080


# ========== DINGTALK ==========
# Required for §13 staff login (Stream Bot work-notification verification
# code) and for AI Card / contact directory sync. Provision in DingTalk
# OA admin -> Developer Backend.
DINGTALK_CORP_ID=CHANGE_ME
DINGTALK_AGENT_ID=CHANGE_ME
DINGTALK_APP_KEY=CHANGE_ME
DINGTALK_APP_SECRET=CHANGE_ME
BOT_HMAC_SECRET=CHANGE_ME


# ========== EMBEDDING WORKER (TEI) ==========
# Boss-locked TEI per versions-locked §D-F. Dev uses the CPU image;
# prod with GPU re-pin to ghcr.io/huggingface/text-embeddings-inference:turing-latest
# and add `runtime: nvidia` in compose override.
TEI_MODEL_ID=BAAI/bge-large-zh-v1.5
TEI_BASE_URL=http://tei:80
TEI_PORT=8081


# ========== IMAGE TAGS ==========
# Authoritative source: NCMU-Wiki/sources/phase0/versions-locked-2026-04-21.md
# Do not bump these in isolation — open an errata in the lock file first.
# DIFY_SANDBOX_IMAGE_TAG tracks an independent version line from dify-api
# (0.2.x today); DIFY_PLUGIN_DAEMON_IMAGE_TAG is also independent and
# currently `0.5.3-local` per v1.13.3 upstream compose pinning.
DIFY_IMAGE_TAG=1.13.3
DIFY_WEB_IMAGE_TAG=1.13.3
DIFY_SANDBOX_IMAGE_TAG=0.2.14
DIFY_PLUGIN_DAEMON_IMAGE_TAG=0.5.3-local
# Dify's inner nginx entrypoint uses bash, which is not in nginx:alpine.
# Keep `latest` here to match Dify upstream; NCMU's outer nginx (TASK-09)
# is NGINX_IMAGE_TAG below and still uses the alpine flavour.
DIFY_NGINX_IMAGE_TAG=latest
# pg-dify image: pgvector extension bundled. Per errata-02, the pg-dify
# instance hosts both Dify's relational tables and its internal vector
# store (in place of the dropped Weaviate container).
DIFY_PGVECTOR_IMAGE_TAG=pgvector/pgvector:pg16
FASTGPT_IMAGE_TAG=v4.14.12
PG_IMAGE_TAG=16-alpine
PGVECTOR_IMAGE_TAG=CHANGE_ME
REDIS_IMAGE_TAG=7-alpine
NGINX_IMAGE_TAG=alpine
TEI_IMAGE_TAG=cpu-latest
PYTHON_IMAGE_TAG=3.11-slim
NODE_IMAGE_TAG=20-alpine
