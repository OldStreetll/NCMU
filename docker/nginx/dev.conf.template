# =====================================================================
# ncmu-nginx : dev profile (TASK-09)
# ---------------------------------------------------------------------
# Security headers per spec §13.3 dev policy:
#   - CSP permits unsafe-inline / unsafe-eval so Dify console's
#     generated Next.js bundle works without extra hashing work.
#   - HSTS NOT emitted (dev runs over plain HTTP).
# Reverse proxy: /console, /v1, /api, /files, /explore, /e/ route into
# dify-nginx (which in turn forwards to dify-api / dify-web /
# dify-plugin-daemon). /api/v1/ncmu/* is a Phase 1 ncmu-backend slot,
# proxied to ncmu-backend. / reverse-proxies the Vite dev server
# (ncmu-spa:5173) — see TASK-FU-NGINX below.
#
# TASK-FU-NGINX (dev profile only; prod = Phase 6 static build):
#   - / now reverse-proxies the live Vite dev server (ncmu-spa:5173)
#     instead of the Phase 0 placeholder, so the SPA is reachable through
#     the single nginx entry point. Vite HMR uses a WebSocket, hence the
#     Upgrade/Connection headers (the $connection_upgrade map below).
#   - "跳 Dify" / "跳 FastGPT" admin buttons hit /dify and /fastgpt.
#     Both Dify (web UI at dify-nginx root) and FastGPT assume they own
#     the root path and emit absolute asset links, so prefix-proxying them
#     under /dify or /fastgpt would 404 their bundles. Instead we 302 to
#     each app's published host port (Dify 8080, FastGPT 3000). $host keeps
#     the redirect host-agnostic; the ports are the compose-published dev
#     ports (no nginx env var exists for them — documented dev tradeoff).
# =====================================================================

# Vite HMR WebSocket upgrade: "upgrade" for WS handshakes, "close" for
# ordinary HTTP. http-context directive — legal here because the rendered
# default.conf is included inside nginx.conf's http {} block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${NCMU_NGINX_HTTP_PORT} default_server;
    server_name ${NCMU_NGINX_SERVER_NAME};

    # ----- security headers (dev: CSP allows unsafe-* for Dify SPA) --
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' http: https: ws: wss:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size ${NCMU_NGINX_CLIENT_MAX_BODY_SIZE};

    # ----- healthcheck (used by compose healthcheck) ------------------
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # ----- Phase 1 ncmu-backend (TASK-25 / E-1 / B-3) -----------------
    # `^~` keeps this ahead of /api/ below so /api/v1/ncmu/* never
    # leaks into the Dify console upstream (which still owns the rest
    # of /api/* — see the /api/ block further down).
    #
    # SSE-friendly settings (B-3): the chat session orchestrator
    # (TASK-27) streams Dify SSE deltas to the SPA — nginx must NOT
    # buffer the response, must hold the upstream connection open for
    # ≥10 min, and must keep HTTP/1.1 keep-alive frames flowing so
    # heartbeat events (TASK-27 AC#7) reach the browser unimpeded.
    #
    # We deliberately do NOT `include proxy_common.conf` here —
    # proxy_common.conf hardcodes proxy_read_timeout / proxy_send_timeout
    # at 300s, and nginx rejects "duplicate directive" if we try to
    # override them after the include in the same location scope. So
    # we inline the equivalent header set and use 600s timeouts.
    location ^~ /api/v1/ncmu/ {
        proxy_pass http://ncmu-backend:8000;

        # mirror proxy_common.conf's headers
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_http_version 1.1;
        proxy_set_header   Connection      "";

        # SSE-specific overrides
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 10s;
    }

    # ----- Dify console + app paths reverse-proxied to dify-nginx -----
    location /console/ { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /v1/      { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /api/     { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /files/   { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /explore/ { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /e/       { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /mcp      { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /triggers { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }

    # ----- external app jump buttons (TASK-FU-NGINX) -----------------
    # Exact matches so they win over the catch-all `location /` below.
    # Dify web UI and FastGPT both assume the root path → 302 to their
    # published dev ports rather than prefix-proxying (which breaks their
    # absolute asset URLs). $host stays browser-relative; ports are the
    # compose-published dev ports.
    location = /dify {
        return 302 http://$host:8080/;
    }
    location = /fastgpt {
        return 302 http://$host:3000/;
    }

    # ----- root: reverse-proxy the Vite dev server (TASK-FU-NGINX) ----
    # The SPA (ncmu-spa) runs `vite dev` on :5173 with client-side
    # routing; nginx forwards everything not matched above (incl. SPA
    # deep links, which Vite falls back to index.html). HMR rides a
    # WebSocket → Upgrade/Connection headers required.
    location / {
        proxy_pass http://ncmu-spa:5173;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header   Upgrade         $http_upgrade;
        proxy_set_header   Connection      $connection_upgrade;
    }
}
