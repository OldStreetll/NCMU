# =====================================================================
# ncmu-nginx : prod profile (TASK-09)
# ---------------------------------------------------------------------
# Security headers per spec §13.3 prod policy:
#   - CSP strict: no 'unsafe-inline', no 'unsafe-eval'. Dify console
#     may need hashed or nonce'd scripts to run under this CSP; that's
#     a Phase 4+ concern (ncmu-web replaces Dify as primary frontend).
#   - HSTS 1y + includeSubDomains, preload-ready.
#   - TLS 1.2 / 1.3 only; cert/key paths come from env.
# HTTP -> HTTPS 301 on port 80.
# =====================================================================

# ---- HTTP listener: only job is to 301 to HTTPS --------------------
server {
    listen ${NCMU_NGINX_HTTP_PORT} default_server;
    server_name ${NCMU_NGINX_SERVER_NAME};

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS listener: real traffic ----------------------------------
server {
    listen ${NCMU_NGINX_HTTPS_PORT} ssl;
    http2 on;
    server_name ${NCMU_NGINX_SERVER_NAME};

    ssl_certificate     ${NCMU_NGINX_CERT_PATH};
    ssl_certificate_key ${NCMU_NGINX_KEY_PATH};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # ----- security headers (prod strict) ----------------------------
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size ${NCMU_NGINX_CLIENT_MAX_BODY_SIZE};

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/v1/ncmu/ {
        default_type text/plain;
        return 503 "Phase 0: ncmu-backend not deployed\n";
    }

    location /console/ { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /v1/      { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /api/     { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /files/   { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /explore/ { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /e/       { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /mcp      { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }
    location /triggers { proxy_pass http://dify-nginx:80; include /etc/nginx/snippets/proxy_common.conf; }

    location / {
        default_type text/plain;
        return 200 "NCMU Phase 0 gateway (prod) — ncmu-web will serve this path from Phase 4.\n";
    }
}
